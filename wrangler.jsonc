{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-tracker",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dd0103f82a11410b91c8fb5752050a21",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WorkoutTemplateAIGeneration",
        "class_name": "WorkoutTemplateAIGeneration",
      },
    ],
  },
  "exports": {
    "WorkoutTemplateAIGeneration": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "placement": {
    "region": "aws:us-east-1",
  },
}
